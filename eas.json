{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ADS_MODE": "test"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "ADS_MODE": "test"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "ADS_MODE": "live",
        "ADMOB_ANDROID_APP_ID": "ca-app-pub-4342572133101591~8389629390"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
